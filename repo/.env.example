DJANGO_SETTINGS_MODULE=resumetailor.settings.dev
DJANGO_SECRET_KEY=change-me-for-local-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3
USE_LOCAL_FILE_STORAGE=true
LOCAL_STORAGE_ROOT=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=resume-tailor
GITHUB_MODELS_ENDPOINT=https://models.inference.ai.azure.com
GITHUB_MODELS_MODEL=gpt-4.1-mini
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_ENABLE_DEV_FALLBACK=true
GITHUB_MODELS_TIMEOUT=90